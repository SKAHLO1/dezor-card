# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Mezo Matsnet
MEZO_RPC_URL=https://rpc.test.mezo.org
ESCROW_ADDRESS=

# AI arbiter wallet — MUST match the aiArbiter address set in the deployed contract.
# This key signs resolveDispute() transactions. Keep it secret; never commit a real value.
ARBITER_PRIVATE_KEY=

# Google Gemini — powers both AI layers (submission review + dispute arbitration).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub API token (optional) — raises the rate limit for scanning deliverable repos.
GITHUB_TOKEN=

# Firebase Admin — full service-account JSON on a single line. Optional in dev (auth is
# bypassed and Firestore-backed routes report "not configured" when unset).
FIREBASE_SERVICE_ACCOUNT=

# Human admin — wallet address with final appeal authority (matches the contract owner).
ADMIN_ADDRESS=
